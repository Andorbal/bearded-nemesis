# Anthropic API Key (OPTIONAL - only needed for API-based usage)
# If you have a Claude Max subscription, you DON'T need this - Claude Code will use browser auth
# If you have an API key from https://console.anthropic.com/, set it here
# ANTHROPIC_API_KEY=your_api_key_here

# Optional: Timezone
TZ=America/Los_Angeles

# Optional: Claude Code version to install
CLAUDE_CODE_VERSION=latest

# Optional: Git delta version for better diffs
GIT_DELTA_VERSION=0.18.2

# Optional: zsh-in-docker version
ZSH_IN_DOCKER_VERSION=1.2.0
